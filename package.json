{
  "name": "@mappedinfo/dsh-paper-library",
  "version": "0.2.0",
  "private": true,
  "description": "Independent literature library with portable PDF annotations for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mappedinfo/dsh-paper-library.git"
  },
  "homepage": "https://github.com/mappedinfo/dsh-paper-library#readme",
  "bugs": {
    "url": "https://github.com/mappedinfo/dsh-paper-library/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "main": "./src/harness/index.mjs",
  "bin": {
    "paper-library": "./src/cli.mjs"
  },
  "exports": {
    ".": "./src/harness/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.py",
    "lib/client.js",
    "web",
    "skills",
    "vendor/csl",
    "cordis.patch.yml",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "HANDOFF.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "docs/api.md",
    "docs/validation.md",
    "docs/annotation-reference-design.md",
    "docs/library-datasets-knowledge-design.md",
    "docs/upstream-manifest.md",
    "docs/validation",
    "LICENSE",
    "licenses",
    "site",
    "docs/paper-review-skill-design.md",
    "docs/whiteboard-design.md",
    "docs/board-pages.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests-js/*.test.mjs",
    "test:harness": "node tests-js/adapter-web-smoke.mjs",
    "test:paper-chat": "node tests-js/paper-chat-harness-smoke.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "verify:github": "node scripts/verify-github.mjs",
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs",
    "install:harness": "node scripts/install-harness.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:board": "node scripts/board-browser-fixture.mjs",
    "test:standalone": "node scripts/board-standalone-fixture.mjs",
    "test:projects": "node scripts/project-ui-fixture.mjs",
    "test:board-harness": "node scripts/board-harness-smoke.mjs",
    "test:selection": "node scripts/selection-browser-fixture.mjs",
    "test:markup-mode": "node scripts/markup-mode-browser-fixture.mjs",
    "test:feedback": "node scripts/feedback-browser-fixture.mjs",
    "test:bibliography": "node scripts/bibliography-browser-fixture.mjs",
    "test:challenge-panel": "node scripts/challenge-panel-browser-fixture.mjs",
    "test:reference": "node scripts/reference-browser-fixture.mjs",
    "verify:pages": "node scripts/verify-pages.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.18",
    "@citation-js/plugin-bibtex": "^0.7.18",
    "citeproc": "^2.4.63",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.5-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  }
}
