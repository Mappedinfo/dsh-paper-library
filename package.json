{
  "name": "@mappedinfo/dsh-paper-library",
  "version": "0.2.5",
  "description": "Independent literature library with portable PDF annotations for DeepSeek Harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mappedinfo/dsh-paper-library.git"
  },
  "homepage": "https://github.com/mappedinfo/dsh-paper-library#readme",
  "bugs": {
    "url": "https://github.com/mappedinfo/dsh-paper-library/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "main": "./src/harness/index.mjs",
  "bin": {
    "paper-library": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/harness/index.mjs",
    "./client": "./lib/client.js",
    "./analysis": "./src/headless-analysis.mjs",
    "./package.json": "./package.json",
    "./field-radar-export": "./src/harness/field-radar-export.mjs"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.py",
    "prompts/**/*.json",
    "lib/client.js",
    "lib/paper-markdown.js",
    "lib/latex-editor.js",
    "lib/latex-spelling.js",
    "web",
    "mcp",
    "skills",
    "vendor/csl",
    "cordis.patch.yml",
    "pyproject.toml",
    "uv.lock",
    "README.md",
    "README.en.md",
    "HANDOFF.md",
    "CHANGELOG.md",
    "THIRD_PARTY.md",
    "docs/api.md",
    "docs/headless-analysis.md",
    "docs/reading-questions.md",
    "docs/research-os-compatibility.md",
    "docs/validation.md",
    "docs/annotation-reference-design.md",
    "docs/ai-annotation-style.md",
    "docs/reading-distribution.md",
    "docs/library-datasets-knowledge-design.md",
    "docs/upstream-manifest.md",
    "docs/validation",
    "LICENSE",
    "licenses",
    "site",
    "docs/latex-projects.md",
    "docs/latex-self-review.md",
    "docs/latex-workbench-design-review.md",
    "docs/external-sources.md",
    "docs/auto-parse-flow.md",
    "docs/paper-review-skill-design.md",
    "docs/whiteboard-design.md",
    "docs/board-pages.md",
    "docs/handwriting-interaction-design.md",
    "lib/slides-editor.js",
    "lib/slides-editor.css",
    "lib/plaindeck-core.mjs",
    "vendor/plaindeck",
    "src/slides",
    "scripts/build-slides.mjs",
    "scripts/slides-motion-smoke.mjs",
    "scripts/vendor-plaindeck.mjs",
    "scripts/rebind-external.py",
    "tsconfig.slides.json",
    "types/slides-env.d.ts",
    "docs/slides-workbench.md",
    "!src/slides/*.test.mjs",
    "vendor/paper-flow",
    "src/paper-flow",
    "examples/paper-flow-teaching.json",
    "lib/paper-flow-editor.js",
    "lib/paper-flow-editor.css",
    "scripts/build-paper-flow.mjs",
    "tsconfig.paper-flow.json",
    "types/paper-flow-env.d.ts",
    "docs/paper-flow.md",
    "docs/workspace-navigation.md",
    "docs/field-radar.md",
    "scripts/import-field-radar-snapshot.mjs",
    "scripts/import-field-radar-relations.mjs",
    "scripts/import-field-radar-analysis.mjs",
    "docs/field-radar-agent-import.md",
    "scripts/export-field-radar.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test tests-js/*.test.mjs",
    "test:harness": "node tests-js/adapter-web-smoke.mjs",
    "test:paper-chat": "node tests-js/paper-chat-harness-smoke.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "verify:github": "node scripts/verify-github.mjs",
    "start": "node src/server.mjs",
    "mcp": "node mcp/server.mjs",
    "dev": "node src/server.mjs",
    "install:harness": "node scripts/install-harness.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:board": "node scripts/board-browser-fixture.mjs",
    "test:standalone": "node scripts/board-standalone-fixture.mjs",
    "test:projects": "node scripts/project-ui-fixture.mjs",
    "test:board-harness": "node scripts/board-harness-smoke.mjs",
    "test:selection": "node scripts/selection-browser-fixture.mjs",
    "test:markup-mode": "node scripts/markup-mode-browser-fixture.mjs",
    "test:pencil": "node scripts/pencil-browser-fixture.mjs",
    "test:pencil-markup": "node scripts/pencil-markup-browser-fixture.mjs",
    "test:pencil-touch": "node scripts/pencil-touch-browser-fixture.mjs",
    "test:linked-handwriting": "node scripts/linked-handwriting-browser-fixture.mjs",
    "test:handwriting-flow": "node scripts/handwriting-flow-browser-fixture.mjs",
    "test:handwriting": "node scripts/handwriting-browser-fixture.mjs",
    "test:handwriting-harness": "node scripts/handwriting-harness-smoke.mjs",
    "test:feedback": "node scripts/feedback-browser-fixture.mjs",
    "test:bibliography": "node scripts/bibliography-browser-fixture.mjs",
    "test:challenge-panel": "node scripts/challenge-panel-browser-fixture.mjs",
    "test:reference": "node scripts/reference-browser-fixture.mjs",
    "verify:pages": "node scripts/verify-pages.mjs",
    "typecheck:slides": "tsc -p tsconfig.slides.json",
    "test:slides": "npm run build && node --test tests-js/slides-*.test.mjs src/slides/*.test.mjs",
    "test:reader-layout": "node scripts/reader-layout-browser-fixture.mjs",
    "typecheck:paper-flow": "tsc -p tsconfig.paper-flow.json",
    "build:docs": "node scripts/build-docs-site.mjs",
    "test:docs-site": "node scripts/docs-site-browser-fixture.mjs",
    "verify:docs-site": "node scripts/verify-docs-site.mjs"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.18",
    "@citation-js/plugin-bibtex": "^0.7.18",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "citeproc": "^2.4.63",
    "colorjs.io": "0.6.1",
    "dictionary-en": "^4.0.0",
    "dompurify": "3.4.17",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "marked": "18.1.3",
    "nspell": "^2.1.5",
    "pptxgenjs": "4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "zod": "4.6.7",
    "zustand": "5.0.14"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "2.0.4"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-atomic-write": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-input-trigger": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-model-selection": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-atomic-write": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-model-selection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-input-trigger": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "esbuild": "^0.25.0",
    "typescript": "5.7.3"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "paper-library",
    "literature-management",
    "pdf-annotation",
